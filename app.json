{
    "expo": {
        "name": "evote",
        "slug": "evote",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "evote",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/images/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "assetBundlePatterns": ["**/*"],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
            "package": "com.tuienn.evote"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-camera",
                {
                    "cameraPermission": "Cho phép $(PRODUCT_NAME) dùng camera để quét mã QR biên lai."
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "Cho phép $(PRODUCT_NAME) truy cập thư viện ảnh để quét mã QR biên lai."
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "d3c7ddef-05d0-4a03-9ab7-ee61c8291c37"
            }
        },
        "owner": "tuienn"
    }
}
